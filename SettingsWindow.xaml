<Window x:Class="UnrealPorting.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="320" Width="420"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Text="General Settings"
                   Foreground="White"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0 0 0 16"/>

        <StackPanel Grid.Row="1">

            <!-- ENGINE VERSION (Global) -->
            <StackPanel>
                <TextBlock Text="Default Engine Version:" Foreground="White" HorizontalAlignment="Center"/>
                <ComboBox x:Name="EngineVersionCombo"
                          Width="150"
                          Background="#2E2E2E"
                          Foreground="White"
                          BorderBrush="#555">
                    <ComboBoxItem Content="UE4.16"/>
                    <ComboBoxItem Content="UE4.19"/>
                    <ComboBoxItem Content="UE4.20"/>
                    <ComboBoxItem Content="UE4.21"/>
                    <ComboBoxItem Content="UE4.22"/>
                    <ComboBoxItem Content="UE4.23"/>
                    <ComboBoxItem Content="UE4.24"/>
                    <ComboBoxItem Content="UE4.25"/>
                    <ComboBoxItem Content="UE4.26"/>
                    <ComboBoxItem Content="UE4.27"/>
                    <ComboBoxItem Content="UE5.0"/>
                    <ComboBoxItem Content="UE5.1"/>
                    <ComboBoxItem Content="UE5.2"/>
                    <ComboBoxItem Content="UE5.3"/>
                    <ComboBoxItem Content="UE5.4"/>
                    <ComboBoxItem Content="UE5.5"/>
                    <ComboBoxItem Content="UE5.6"/>
                </ComboBox>
            </StackPanel>

            <!-- ENGINE VERSION (Profile Specific) -->
            <StackPanel>
                <TextBlock Text="Profile Engine Version:" Foreground="White" HorizontalAlignment="Center"/>
                <ComboBox x:Name="EngineComboBox"
                          Width="150"
                          Background="#2E2E2E"
                          Foreground="White"
                          BorderBrush="#555">
                    <ComboBoxItem Content="UE4.16"/>
                    <ComboBoxItem Content="UE4.19"/>
                    <ComboBoxItem Content="UE4.20"/>
                    <ComboBoxItem Content="UE4.21"/>
                    <ComboBoxItem Content="UE4.22"/>
                    <ComboBoxItem Content="UE4.23"/>
                    <ComboBoxItem Content="UE4.24"/>
                    <ComboBoxItem Content="UE4.25"/>
                    <ComboBoxItem Content="UE4.26"/>
                    <ComboBoxItem Content="UE4.27"/>
                    <ComboBoxItem Content="UE5.0"/>
                    <ComboBoxItem Content="UE5.1"/>
                    <ComboBoxItem Content="UE5.2"/>
                    <ComboBoxItem Content="UE5.3"/>
                    <ComboBoxItem Content="UE5.4"/>
                    <ComboBoxItem Content="UE5.5"/>
                    <ComboBoxItem Content="UE5.6"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Margin="0,20,0,0">
                <!-- CUSTOM MAPPINGS -->
                <CheckBox x:Name="UseCustomMappingsBox"
                          Content="Use custom .usmap file"
                          Foreground="White"/>
            </StackPanel>
            <!-- MAPPINGS PICKER -->
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="MappingsPathBox"
                         Width="300"
                         Background="#2E2E2E"
                         Foreground="White"
                         BorderBrush="#555"/>
                <Button Content="Browse..."
                        Width="100"
                        Click="SelectMappings_Click"
                        Foreground="White"
                        Background="#2E2E2E"
                        BorderBrush="RoyalBlue"/>
            </StackPanel>

        </StackPanel>

        <!-- SAVE BUTTON -->
        <Button Grid.Row="2"
                Content="Save Settings"
                Height="42"
                Background="#303030"
                Foreground="White"
                BorderBrush="RoyalBlue"
                Click="BtnSave_Click"/>
    </Grid>

    <Window.Resources>

        <!-- DARK COMBOBOX -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="25"/>
                            </Grid.ColumnDefinitions>

                            <!-- Current Selected Item -->
                            <ContentPresenter x:Name="ContentSite"
                                  Margin="6,3,0,3"
                                  IsHitTestVisible="False"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>

                            <!-- Drop Button -->
                            <ToggleButton x:Name="ToggleButton"
                              Grid.Column="1"
                              Focusable="False"
                              Background="#2A2A2A"
                              BorderBrush="#555"
                              BorderThickness="1"
                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              ClickMode="Press">
                                <Path Data="M 0 0 L 4 4 L 8 0 Z"
                          Fill="White"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                            </ToggleButton>

                            <!-- Popup -->
                            <Popup x:Name="Popup"
                       Placement="Bottom"
                       AllowsTransparency="True"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       Focusable="False"
                       PopupAnimation="Slide">
                                <Border Background="#1E1E1E"
                            BorderBrush="#555"
                            BorderThickness="1"
                            Padding="2">
                                    <ScrollViewer Margin="2"
                                      SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- TRIGGERS -->
                        <ControlTemplate.Triggers>

                            <!-- Disable style -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToggleButton" Property="Opacity" Value="0.4"/>
                                <Setter Property="Foreground" Value="#777"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- DARK COMBOBOX ITEMS -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Padding" Value="4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#444"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>
</Window>
