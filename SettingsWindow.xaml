<Window x:Class="UnrealPorting.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="480" Width="520"
        Background="#0E0E10"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>

        <!-- CARD PANEL -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#2A2A2D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0 0 0 14"/>
        </Style>

        <!-- LABEL STYLE -->
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0 6 0 2"/>
        </Style>

        <!-- COMBOBOX DARK -->
        <Style TargetType="ComboBox" BasedOn="{x:Null}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1F1F23"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="25"/>
                            </Grid.ColumnDefinitions>

                            <!-- Main box -->
                            <Border Background="#1F1F23"
                                    BorderBrush="#444"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Grid.ColumnSpan="2">
                                <ContentPresenter Margin="6,3,0,3"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}" />
                            </Border>

                            <!-- Dropdown button -->
                            <ToggleButton x:Name="Btn"
                                          Grid.Column="1"
                                          Background="#1F1F23"
                                          BorderBrush="#444"
                                          BorderThickness="1"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">

                                <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                      Fill="White"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </ToggleButton>

                            <!-- Dropdown popup -->
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide">
                                <Border Background="#1E1E1E"
                                        BorderBrush="#444"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COMBOBOX ITEMS -->
        <Style TargetType="ComboBoxItem" BasedOn="{x:Null}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1F1F23"/>
            <Setter Property="Padding" Value="4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D2D33"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3A3A40"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- BUTTON -->
        <Style TargetType="Button" BasedOn="{x:Null}">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#5AA6FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8 4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#233043"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#182433"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>



    <!-- ===========================
         MAIN UI LAYOUT
    ================================ -->
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Text="Settings"
                   Foreground="#E5E7EB"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0 0 0 16"/>


        <!-- MAIN CONTENT -->
        <StackPanel Grid.Row="1">

            <!-- GENERAL ENGINE SETTINGS -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="General Engine Version"
                               Style="{StaticResource SettingLabel}" />

                    <ComboBox x:Name="EngineVersionCombo"
                              Width="160">
                        <ComboBoxItem Content="UE4.16"/>
                        <ComboBoxItem Content="UE4.19"/>
                        <ComboBoxItem Content="UE4.20"/>
                        <ComboBoxItem Content="UE4.21"/>
                        <ComboBoxItem Content="UE4.22"/>
                        <ComboBoxItem Content="UE4.23"/>
                        <ComboBoxItem Content="UE4.24"/>
                        <ComboBoxItem Content="UE4.25"/>
                        <ComboBoxItem Content="UE4.26"/>
                        <ComboBoxItem Content="UE4.27"/>
                        <ComboBoxItem Content="UE5.0"/>
                        <ComboBoxItem Content="UE5.1"/>
                        <ComboBoxItem Content="UE5.2"/>
                        <ComboBoxItem Content="UE5.3"/>
                        <ComboBoxItem Content="UE5.4"/>
                        <ComboBoxItem Content="UE5.5"/>
                        <ComboBoxItem Content="UE5.6"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- PROFILE ENGINE VERSION -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Profile's Engine Version"
                               Style="{StaticResource SettingLabel}" />

                    <ComboBox x:Name="EngineComboBox"
                              Width="160">
                        <ComboBoxItem Content="UE4.16"/>
                        <ComboBoxItem Content="UE4.19"/>
                        <ComboBoxItem Content="UE4.20"/>
                        <ComboBoxItem Content="UE4.21"/>
                        <ComboBoxItem Content="UE4.22"/>
                        <ComboBoxItem Content="UE4.23"/>
                        <ComboBoxItem Content="UE4.24"/>
                        <ComboBoxItem Content="UE4.25"/>
                        <ComboBoxItem Content="UE4.26"/>
                        <ComboBoxItem Content="UE4.27"/>
                        <ComboBoxItem Content="UE5.0"/>
                        <ComboBoxItem Content="UE5.1"/>
                        <ComboBoxItem Content="UE5.2"/>
                        <ComboBoxItem Content="UE5.3"/>
                        <ComboBoxItem Content="UE5.4"/>
                        <ComboBoxItem Content="UE5.5"/>
                        <ComboBoxItem Content="UE5.6"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- CUSTOM MAPPINGS -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="UseCustomMappingsBox"
                              Content="Enable custom .usmap file"
                              Foreground="White"/>

                    <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
                        <TextBox x:Name="MappingsPathBox"
                                 Width="260"
                                 Background="#1F1F23"
                                 Foreground="White"/>
                        <Button Content="Browse"
                                Width="80"
                                Margin="8 0 0 0"
                                Click="SelectMappings_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>


        <!-- SAVE BUTTON -->
        <StackPanel Background="Transparent" Orientation="Vertical" Grid.Row="2">
            <Button Grid.Row="2"
                Content="Save Settings"
                FontWeight="Bold"
                Height="42"
                Margin="0 14 0 0"
                Foreground="White"
                Background="#FF14254E"
                BorderBrush="RoyalBlue"
                Click="BtnSave_Click"/>
            <StackPanel.Effect>
                <DropShadowEffect Color="RoyalBlue" BlurRadius="50" ShadowDepth="0" Opacity="0.6"/>
            </StackPanel.Effect>
        </StackPanel>
    </Grid>

</Window>
