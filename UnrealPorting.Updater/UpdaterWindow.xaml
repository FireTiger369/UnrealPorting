<Window x:Class="UnrealPorting.Updater.UpdaterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UnrealPorting Updater"
        Width="620" Height="340"
        Background="#111218"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <Storyboard x:Key="SpinnerPremium" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                     Storyboard.TargetProperty="Angle"
                     From="0" To="360"
                     Duration="0:0:1.4"
                     RepeatBehavior="Forever"/>

            <DoubleAnimation Storyboard.TargetName="SweepRotate"
                     Storyboard.TargetProperty="Angle"
                     From="0" To="360"
                     Duration="0:0:1.2"
                     RepeatBehavior="Forever"/>
        </Storyboard>
        <!-- Theme Colors -->
            <SolidColorBrush x:Key="PanelBgBrush" Color="#14141A"/>
            <SolidColorBrush x:Key="BorderBrushDark" Color="#26262C"/>
            <SolidColorBrush x:Key="AccentBlue" Color="#5AA6FF"/>

        <DropShadowEffect x:Key="PaneGlow"
                              Color="#5AA6FF"
                              BlurRadius="25"
                              ShadowDepth="0"
                              Opacity="0.25"/>
    </Window.Resources>

    <Grid Background="#111218" Margin="20">

        <!-- Border card -->
        <Border Background="{StaticResource PanelBgBrush}"
                CornerRadius="14"
                BorderBrush="{StaticResource BorderBrushDark}"
                BorderThickness="1"
                Effect="{StaticResource PaneGlow}"
                Padding="25">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- header -->
                    <RowDefinition Height="*"/>
                    <!-- center content -->
                    <RowDefinition Height="Auto"/>
                    <!-- progress -->
                </Grid.RowDefinitions>

                <!-- TOP-RIGHT SPINNER (1:1 with MainWindow overlay) -->
                <Grid x:Name="SpinnerVisual"
                      Width="72" Height="72"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,6,6,0"
                      RenderTransformOrigin="0.5,0.5"
                      ClipToBounds="False"
                      SnapsToDevicePixels="True"
                      UseLayoutRounding="True"
                      IsHitTestVisible="False">

                    <!-- inner content kept EXACTLY the same size/geometry -->
                    <Grid Width="40" Height="40"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          ClipToBounds="False">

                        <!-- background ring (slightly more visible since no overlay veil) -->
                        <Ellipse Width="40" Height="40"
                                 Stroke="#26FFFFFF"
                                 StrokeThickness="4"/>

                        <!-- main spinning arc -->
                        <Grid RenderTransformOrigin="0.5,0.5" ClipToBounds="False">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                            </Grid.RenderTransform>

                            <Path StrokeThickness="4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round">
                                <Path.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#5AA6FF" Offset="0"/>
                                        <GradientStop Color="#A47CFF" Offset="0.5"/>
                                        <GradientStop Color="#5AA6FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Path.Stroke>

                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure StartPoint="20,4">
                                            <ArcSegment Point="36,20"
                                                        Size="16,16"
                                                        SweepDirection="Clockwise"
                                                        IsLargeArc="False"/>
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>

                                <Path.Effect>
                                    <DropShadowEffect Color="#6EA8FF"
                                                      BlurRadius="45"
                                                      Opacity="0.9"
                                                      ShadowDepth="0"/>
                                </Path.Effect>
                            </Path>
                        </Grid>

                        <!-- energy sweep -->
                        <Grid RenderTransformOrigin="0.5,0.5" ClipToBounds="False">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="SweepRotate" Angle="0"/>
                            </Grid.RenderTransform>

                            <Path StrokeThickness="4"
                                  Opacity="0.35"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round">
                                <Path.Stroke>
                                    <RadialGradientBrush RadiusX="1" RadiusY="1"
                                                         Center="0.5,0.5"
                                                         GradientOrigin="0.5,0.5">
                                        <GradientStop Color="#FF00CAFF" Offset="0"/>
                                        <GradientStop Color="#A08230FF" Offset="0.4"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </RadialGradientBrush>
                                </Path.Stroke>

                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure StartPoint="20,4">
                                            <ArcSegment Point="36,20"
                                                        Size="16,16"
                                                        SweepDirection="Clockwise"
                                                        IsLargeArc="False"/>
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>

                                <Path.Effect>
                                    <DropShadowEffect Color="#A47CFF"
                                                      BlurRadius="45"
                                                      ShadowDepth="0"
                                                      Opacity="0.75"/>
                                </Path.Effect>
                            </Path>
                        </Grid>
                    </Grid>
                </Grid>


                <!-- TOP HEADER -->
                <TextBlock Text="Updating UnrealPorting"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#E5E7EB"
                           Margin="0 0 0 20"/>

                <!-- VERSION TEXT (centered) -->
                <TextBlock x:Name="VersionText"
                           Grid.Row="1"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Text="Preparing update…"/>

                <!-- PROGRESS PANEL -->
                <Grid Grid.Row="2"
                      Margin="0 25 0 0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Percent -->
                    <TextBlock x:Name="PercentText"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Text="0%"/>

                    <!-- Progress bar -->
                    <Border Grid.Column="1"
                            Background="#0E0E10"
                            CornerRadius="8"
                            BorderBrush="#26262C"
                            BorderThickness="1"
                            Padding="3"
                            Effect="{StaticResource PaneGlow}"
                            Margin="10 0 0 0">

                        <ProgressBar x:Name="ProgressBar"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Height="18"
                                     Foreground="#5AA6FF"
                                     Background="#2A2A2D"
                                     BorderThickness="0"/>
                    </Border>

                </Grid>

            </Grid>
        </Border>

    </Grid>
</Window>
