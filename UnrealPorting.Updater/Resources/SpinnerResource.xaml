<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ======================= -->
    <!--   Spinner Animation     -->
    <!-- ======================= -->

    <Storyboard x:Key="SpinnerPremium" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                         Storyboard.TargetName="SpinnerRotate"
                         From="0" To="360"
                         Duration="0:0:1.4"
                         RepeatBehavior="Forever"/>

        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                         Storyboard.TargetName="SweepRotate"
                         From="0" To="360"
                         Duration="0:0:1.2"
                         RepeatBehavior="Forever"/>
    </Storyboard>

    <!-- ======================= -->
    <!--   Spinner Graphic       -->
    <!-- ======================= -->

    <Grid x:Key="SpinnerGraphic"
          Width="48"
          Height="48"
          RenderTransformOrigin="0.5,0.5">

        <!-- OUTER ROTATION -->
        <Grid.RenderTransform>
            <RotateTransform x:Name="SpinnerRotate" />
        </Grid.RenderTransform>

        <!-- SWEEP ARC -->
        <Path RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
                <RotateTransform x:Name="SweepRotate" />
            </Path.RenderTransform>

            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="20,4">
                        <ArcSegment Point="36,20"
                                    Size="16,16"
                                    SweepDirection="Clockwise"
                                    IsLargeArc="False"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>

            <Path.Stroke>
                <SolidColorBrush Color="#5AA6FF"/>
            </Path.Stroke>

            <Path.StrokeThickness>4</Path.StrokeThickness>
            <Path.StrokeStartLineCap>Round</Path.StrokeStartLineCap>
            <Path.StrokeEndLineCap>Round</Path.StrokeEndLineCap>

        </Path>

    </Grid>

</ResourceDictionary>
