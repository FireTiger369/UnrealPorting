<Window x:Class="UnrealPorting.AESWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AES Key Manager"
        Height="600"
        Width="900"
        Background="#111218"
        Foreground="White"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>

        <!-- Glow effect -->
        <DropShadowEffect x:Key="PanelGlow"
                          Color="#5AA6FF"
                          BlurRadius="25"
                          ShadowDepth="0"
                          Opacity="0.40"/>

        <!-- Rounded list container (same as search results) -->
        <Style x:Key="AESItemContainer" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#1F1F23"/>
            <Setter Property="BorderBrush" Value="#26262C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0 6"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000"
                              BlurRadius="18"
                              ShadowDepth="0"
                              Opacity="0.35"/>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Textbox Style -->
        <Style x:Key="AESInputBox" TargetType="TextBox">
            <Setter Property="Background" Value="#18181B"/>
            <!-- Lighter for clarity -->
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <!-- Softer white -->
            <Setter Property="BorderBrush" Value="#3A3C46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="10 0 0 0"/>
            <Setter Property="FontSize" Value="14"/>

            <!-- MUCH clearer text than Consolas -->
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas"/>

            <!-- Force sharp text rendering -->
            <Setter Property="TextOptions.TextFormattingMode"
            Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode"
            Value="ClearType"/>
            <Setter Property="TextOptions.TextHintingMode"
            Value="Fixed"/>

            <!-- Rounded matching theme -->
            <Setter Property="Border.CornerRadius" Value="6"/>

            <!-- Slight highlight on focus -->
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#5AA6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Nice blue-themed button -->
        <Style x:Key="BlueButton" TargetType="Button">
            <Setter Property="Background" Value="#14254E"/>
            <!-- deep blue -->
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="6 4"/>
            <Setter Property="Margin" Value="6 0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#5AA6FF"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#5AA6FF"
                              BlurRadius="15"
                              ShadowDepth="0"
                              Opacity="0.45"/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>

                <!-- MUCH more readable hover -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#223E75"/>
                    <!-- brighter blue -->
                    <Setter Property="BorderBrush" Value="#8EBEFF"/>
                    <!-- lighter outline -->
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#8EBEFF"
                                      BlurRadius="22"
                                      ShadowDepth="0"
                                      Opacity="0.7"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>

                <!-- Clicked -->
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D1834"/>
                    <!-- darker but still readable -->
                    <Setter Property="BorderBrush" Value="#5AA6FF"/>
                </Trigger>

            </Style.Triggers>
        </Style>

        <!-- Gray cancel button -->
        <Style x:Key="GrayButton" TargetType="Button">
            <Setter Property="Background" Value="#1F1F23"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="6 4"/>
            <Setter Property="Margin" Value="6 0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#26262C"/>

            <Style.Triggers>

                <!-- Way more visible hover -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2B2D33"/>
                    <Setter Property="BorderBrush" Value="#5AA6FF"/>
                    <Setter Property="Foreground" Value="White"/>
                    <!-- ensures no loss in contrast -->
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#5AA6FF"
                                      BlurRadius="18"
                                      ShadowDepth="0"
                                      Opacity="0.55"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#18181B"/>
                    <Setter Property="BorderBrush" Value="#5AA6FF"/>
                </Trigger>

            </Style.Triggers>
        </Style>

    </Window.Resources>


    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Text="AES Key Manager"
                   Grid.Row="0"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,14"
                   Foreground="#E5E7EB"/>

        <!-- MAIN SCROLL AREA -->
        <Border Grid.Row="1"
                Background="#14141A"
                CornerRadius="12"
                BorderBrush="#26262C"
                BorderThickness="1"
                Padding="10"
                Effect="{StaticResource PanelGlow}">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Background="Transparent">
                <StackPanel x:Name="AESListPanel"
                            Orientation="Vertical"/>
            </ScrollViewer>
        </Border>

        <!-- BUTTON BAR -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">

            <Button Content="Cancel"
                    Width="140"
                    Height="42"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#20212A"
                    Click="Cancel_Click"/>
            <Button Content="Confirm"
                    Width="140"
                    Height="42"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#5AA6FF"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="Confirm_Click">
                <Button.Effect>
                    <DropShadowEffect Color="#5AA6FF"
                                      BlurRadius="20"
                                      ShadowDepth="0"
                                      Opacity="0.6"/>
                </Button.Effect>
            </Button>

        </StackPanel>

    </Grid>
</Window>
