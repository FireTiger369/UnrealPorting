<Window x:Class="UnrealPorting.DirectorySelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Profiles"
        Width="600"
        Height="500"
        Background="#0E0E10"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- ==== CARD PANEL (Matches AES/Search/Settings) ==== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#26262C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0 0 0 14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#5AA6FF"
                                      BlurRadius="22"
                                      ShadowDepth="0"
                                      Opacity="0.28"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==== Section Label ==== -->
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0 0 0 10"/>
        </Style>

        <!-- ==== Normal Text ==== -->
        <Style TargetType="TextBlock" BasedOn="{StaticResource HeaderText}">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0 4"/>
        </Style>

        <!-- ==== Input Boxes ==== -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1F1F23"/>
            <Setter Property="BorderBrush" Value="#26262C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0 4 0 8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="6"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <!-- ======================
         MAIN WINDOW LAYOUT
    =========================== -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================
             EXISTING PROFILES
        ====================== -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Select Existing Profile"
                           Style="{StaticResource HeaderText}"/>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Profile:"
                               Width="119"
                               Margin="25 0 0 0"/>

                    <ComboBox x:Name="ExistingProfilesCombo"
                              Margin="0 0 0 0"
                              Width="260"
                              Background="#1F1F23"
                              Foreground="White"
                              BorderBrush="#26262C">
                        <ComboBox.Resources>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="#1F1F23"/>
                                <Setter Property="Padding" Value="4"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2C3A56"/>
                                        <Setter Property="BorderBrush" Value="#5AA6FF"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#14254E"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Resources>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Border>


        <!-- ===================
             NEW PROFILE CREATION
        ====================== -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid Margin="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Add New Game Profile"
                           Style="{StaticResource HeaderText}"
                           Grid.ColumnSpan="2"
                           Margin="0 0 0 12"/>

                <!-- Name -->
                <TextBlock Text="Profile Name:" Grid.Row="1" Grid.Column="0"/>
                <TextBox x:Name="NewNameBox" Grid.Row="1" Grid.Column="1"/>

                <!-- Directory -->
                <TextBlock Text="Game Directory:" Grid.Row="2" Grid.Column="0"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="NewDirBox" Width="260"/>
                    <Button Content="Browse..."
                            Margin="8 0 0 0"
                            Click="BrowseDirectory_Click" 
                            Width="90" 
                            Height="34"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Background="#20212A"
                            BorderBrush="#2A2A2D"
                            BorderThickness="1"
                            Cursor="Hand"/>
                </StackPanel>

                <!-- Engine -->
                <TextBlock Text="Engine Version:" Grid.Row="3" Grid.Column="0"/>
                <ComboBox x:Name="NewEngineCombo"
                          Grid.Row="3"
                          Grid.Column="1"
                          Background="#1F1F23"
                          Foreground="White"
                          BorderBrush="#26262C"
                          Margin="0,4,113,60">
                    <ComboBoxItem Content="UE4.16"/>
                    <ComboBoxItem Content="UE4.19"/>
                    <ComboBoxItem Content="UE4.20"/>
                    <ComboBoxItem Content="UE4.21"/>
                    <ComboBoxItem Content="UE4.22"/>
                    <ComboBoxItem Content="UE4.23"/>
                    <ComboBoxItem Content="UE4.24"/>
                    <ComboBoxItem Content="UE4.25"/>
                    <ComboBoxItem Content="UE4.26"/>
                    <ComboBoxItem Content="UE4.27"/>
                    <ComboBoxItem Content="UE5.0"/>
                    <ComboBoxItem Content="UE5.1"/>
                    <ComboBoxItem Content="UE5.2"/>
                    <ComboBoxItem Content="UE5.3"/>
                    <ComboBoxItem Content="UE5.4"/>
                    <ComboBoxItem Content="UE5.5"/>
                    <ComboBoxItem Content="UE5.6"/>
                    <ComboBoxItem Content="UE5.7"/>
                    <ComboBoxItem Content="UE5.8"/>
                </ComboBox>

                <!-- Add Button -->
                <Button Content="Add Game Profile"
                        Grid.Row="4"
                        Grid.ColumnSpan="2"
                        Height="38"
                        Margin="0 50 0 0"
                        Click="AddGame_Click"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Background="#20212A"
                        BorderBrush="#2A2A2D"
                        BorderThickness="1"
                        Cursor="Hand">
                    <Button.Effect>
                        <DropShadowEffect Color="#5AA6FF"
                                          BlurRadius="20"
                                          ShadowDepth="0"
                                          Opacity="0.6"/>
                    </Button.Effect>
                    </Button>
            </Grid>
        </Border>


        <!-- ===================
             OK / CANCEL
        ====================== -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 10 0 0">
            <Button Content="Cancel"
                    Width="110"
                    Height="32"
                    Margin="5"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#20212A"
                    BorderBrush="#2A2A2D"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="Cancel_Click"/>
            <Button Content="OK"
                    Width="110"
                    Height="32"
                    Margin="5"
                    FontWeight="SemiBold"
                    Click="OK_Click"
                    Foreground="White"
                    Background="#5AA6FF"
                    BorderBrush="#5AA6FF"
                    BorderThickness="1"
                    Cursor="Hand">
                <Button.Effect>
                    <DropShadowEffect Color="#5AA6FF"
                                      BlurRadius="20"
                                      ShadowDepth="0"
                                      Opacity="0.6"/>
                </Button.Effect>
            </Button>
        </StackPanel>

    </Grid>
</Window>
