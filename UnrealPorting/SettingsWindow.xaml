<Window x:Class="UnrealPorting.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="480" Width="520"
        Background="#0E0E10"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>

        <!-- ==========================
             STYLES
        =========================== -->

        <!-- CARD PANEL -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#14141A"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#26262C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0 0 0 14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#5AA6FF"
                                      BlurRadius="18"
                                      ShadowDepth="0"
                                      Opacity="0.35"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- LABEL -->
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0 0 0 4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- TEXTBOX -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1F1F23"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2A2A2D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6 4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COMBOBOX -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1F1F23"/>
            <Setter Property="BorderBrush" Value="#2A2A2D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>

                            <!-- Main box -->
                            <Border Background="#1F1F23"
                                    BorderBrush="#2A2A2D"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Grid.ColumnSpan="2">
                                <ContentPresenter Margin="6,3,0,3"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"/>
                            </Border>

                            <!-- Dropdown button -->
                            <ToggleButton x:Name="Drop"
                                          Grid.Column="1"
                                          Background="#1F1F23"
                                          BorderBrush="#2A2A2D"
                                          BorderThickness="1"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Path Data="M 0 0 L 6 6 L 12 0 Z"
                                      Fill="White"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </ToggleButton>

                            <!-- Dropdown Items -->
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True">
                                <Border Background="#14141A"
                                        BorderBrush="#2A2A2D"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COMBOBOX ITEMS -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1F1F23"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2C3A56"/>
                    <Setter Property="BorderBrush" Value="#5AA6FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#14254E"/>
                    <Setter Property="BorderBrush" Value="#5AA6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>



    <!-- ===========================
         MAIN WINDOW LAYOUT
    =============================== -->
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Text="Settings"
                   Foreground="#E5E7EB"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0 0 0 16"/>


        <!-- MAIN SETTINGS -->
        <StackPanel Grid.Row="1">

            <!-- GENERAL ENGINE SETTINGS -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="General Engine Version" Style="{StaticResource SettingLabel}" />
                    <ComboBox x:Name="EngineVersionCombo" Width="160">
                        <ComboBoxItem Content="UE4.16"/>
                        <ComboBoxItem Content="UE4.19"/>
                        <ComboBoxItem Content="UE4.20"/>
                        <ComboBoxItem Content="UE4.21"/>
                        <ComboBoxItem Content="UE4.22"/>
                        <ComboBoxItem Content="UE4.23"/>
                        <ComboBoxItem Content="UE4.24"/>
                        <ComboBoxItem Content="UE4.25"/>
                        <ComboBoxItem Content="UE4.26"/>
                        <ComboBoxItem Content="UE4.27"/>
                        <ComboBoxItem Content="UE5.0"/>
                        <ComboBoxItem Content="UE5.1"/>
                        <ComboBoxItem Content="UE5.2"/>
                        <ComboBoxItem Content="UE5.3"/>
                        <ComboBoxItem Content="UE5.4"/>
                        <ComboBoxItem Content="UE5.5"/>
                        <ComboBoxItem Content="UE5.6"/>
                        <ComboBoxItem Content="UE5.7"/>
                        <ComboBoxItem Content="UE5.8"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- PROFILE ENGINE VERSION -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Profile's Engine Version" Style="{StaticResource SettingLabel}" />
                    <ComboBox x:Name="EngineComboBox" Width="160">
                        <ComboBoxItem Content="UE4.16"/>
                        <ComboBoxItem Content="UE4.19"/>
                        <ComboBoxItem Content="UE4.20"/>
                        <ComboBoxItem Content="UE4.21"/>
                        <ComboBoxItem Content="UE4.22"/>
                        <ComboBoxItem Content="UE4.23"/>
                        <ComboBoxItem Content="UE4.24"/>
                        <ComboBoxItem Content="UE4.25"/>
                        <ComboBoxItem Content="UE4.26"/>
                        <ComboBoxItem Content="UE4.27"/>
                        <ComboBoxItem Content="UE5.0"/>
                        <ComboBoxItem Content="UE5.1"/>
                        <ComboBoxItem Content="UE5.2"/>
                        <ComboBoxItem Content="UE5.3"/>
                        <ComboBoxItem Content="UE5.4"/>
                        <ComboBoxItem Content="UE5.5"/>
                        <ComboBoxItem Content="UE5.6"/>
                        <ComboBoxItem Content="UE5.7"/>
                        <ComboBoxItem Content="UE5.8"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- CUSTOM MAPPINGS -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="UseCustomMappingsBox"
                              Content="Enable custom .usmap file"
                              Foreground="White"
                              Margin="0 0 0 8"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="MappingsPathBox"
                                 Width="260"/>
                        <Button Content="Browse"
                                Width="90"
                                Height="32"
                                Margin="9, 0, 10, 0"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Background="#20212A"
                                BorderBrush="#2A2A2D"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="SelectMappings_Click">
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>


        <!-- SAVE BUTTON -->
        <Button Grid.Row="2"
                Content="Save Settings"
                Height="44"
                Margin="0 10 0 0"
                FontWeight="SemiBold"
                Foreground="White"
                Background="#5AA6FF"
                BorderBrush="#5AA6FF"
                BorderThickness="1"
                Cursor="Hand"
                Click="BtnSave_Click">
            <Button.Effect>
                <DropShadowEffect Color="#5AA6FF"
                                  BlurRadius="20"
                                  ShadowDepth="0"
                                  Opacity="0.6"/>
            </Button.Effect>
        </Button>
    </Grid>

</Window>
