<Window x:Class="UnrealPorting.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="ToastWindow"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Border x:Name="OuterBorder"
            Background="#1F1F23"
            CornerRadius="12"
            Padding="0"
            Opacity="1"
            MinWidth="360"
            MaxWidth="420"
            Margin="2">

        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" X="60"/>
        </Border.RenderTransform>
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Accent bar (color changes in code) -->
            <Border x:Name="Accent"
                    Grid.Column="0"
                    Width="8"
                    Background="#5AA6FF"
                    CornerRadius="12,0,0,12">
                <Border.Effect>
                    <DropShadowEffect Color="#5AA6FF"
                                      BlurRadius="18"
                                      ShadowDepth="0"
                                      Opacity="0.55"/>
                </Border.Effect>
            </Border>

            <!-- Message -->
            <TextBlock x:Name="MessageText"
                       Grid.Column="1"
                       Margin="14,10,14,12"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
            <Border x:Name="TimerBar"
                    Height="3"
                    Background="#5AA6FF"
                    CornerRadius="0,2,2,2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="5,0,5,0"
                    Width="0"
                    Grid.ColumnSpan="2">
                <Border.Effect>
                    <DropShadowEffect Color="#5AA6FF"
                                      BlurRadius="12"
                                      ShadowDepth="0"
                                      Opacity="0.85"/>
                </Border.Effect>
            </Border>
        </Grid>
    </Border>
</Window>
