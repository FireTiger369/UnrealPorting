<Window x:Class="UnrealPorting.LogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logs"
        Height="600" Width="900"
        Background="#0E0E10"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>

        <!-- Card panel -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#2A2A2D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0 0 0 14"/>
        </Style>

        <!-- Buttons -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#5AA6FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8 4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#233043"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#182433"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="Application Logs"
                   Foreground="#E5E7EB"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0 0 0 16"/>

        <!-- Main content -->
        <Border Style="{StaticResource Card}"
                Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ListBox x:Name="LogsList"
                         Background="#18181B"
                         Foreground="White"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="13"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                </ListBox>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 10 0 0">

            <Button Content="Clear"
                    Width="100"
                    Height="32"
                    Margin="0 0 10 0"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#20212A"
                    BorderBrush="#2A2A2D"
                    Click="Clear_Click"/>

            <Button Content="Close"
                    Width="100"
                    Height="32"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#5AA6FF"
                    BorderBrush="#5AA6FF"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="Close_Click">
                <Button.Effect>
                    <DropShadowEffect Color="#5AA6FF"
                                      BlurRadius="20"
                                      ShadowDepth="0"
                                      Opacity="0.6"/>
                </Button.Effect>
            </Button>
        </StackPanel>

    </Grid>
</Window>
