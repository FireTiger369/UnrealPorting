<Window x:Class="UnrealPorting.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:UnrealPorting"
        Title="Unreal Porting Tool"
        Height="900" Width="1600"
        Background="#2E2E2E"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Glow effect for panels -->
        <DropShadowEffect x:Key="PanelGlow"
                          Color="#5AA6FF"
                          BlurRadius="30"
                          ShadowDepth="0"
                          Opacity="0.35"/>

        <!-- Icons -->
        <BitmapImage x:Key="FolderClosedIcon" UriSource="Icons/folder_closed.png"/>
        <BitmapImage x:Key="FolderOpenIcon"  UriSource="Icons/folder_open.png"/>
        <BitmapImage x:Key="AssetIcon" UriSource="Icons/asset_icon.png"/>

        <!-- Spinner color -->
        <SolidColorBrush x:Key="SpinnerBrush" Color="#5AA6FF"/>

        <!-- FortForge-ish colors -->
        <SolidColorBrush x:Key="HeaderBgBrush" Color="#111218"/>
        <SolidColorBrush x:Key="SidebarBgBrush" Color="#0E0E10"/>
        <SolidColorBrush x:Key="SidebarButtonBg" Color="#15161C"/>
        <SolidColorBrush x:Key="SidebarButtonHoverBg" Color="#20212A"/>
        <SolidColorBrush x:Key="SidebarButtonText" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="PanelBgBrush" Color="#18181B"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#2A2A2D"/>

        <!-- Sidebar glow strip -->
        <LinearGradientBrush x:Key="SidebarGlowBrush"
                             StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#66A8FFFF" Offset="0.0"/>
            <GradientStop Color="#5AA6FF" Offset="0.25"/>
            <GradientStop Color="#A47CFF" Offset="0.55"/>
            <GradientStop Color="#5AA6FF" Offset="0.85"/>
            <GradientStop Color="#66A8FFFF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Tree styles -->
        <Style x:Key="DarkTreeView" TargetType="TreeView">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="DarkTreeViewItem" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Sidebar nav button -->
        <Style x:Key="SidebarNavButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SidebarButtonBg}"/>
            <Setter Property="Foreground" Value="{StaticResource SidebarButtonText}"/>
            <Setter Property="BorderBrush" Value="#00000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="6,0,0,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SidebarButtonHoverBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Rounded modern tab header (kept for future use) -->
        <Style x:Key="roundedmoderntab" TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Background="Transparent">
                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ContentPresenter x:Name="TabText"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>

                                <Border x:Name="Underline"
                                        Height="3"
                                        Width="26"
                                        Background="#5AA6FF"
                                        CornerRadius="2"
                                        Margin="0,6,0,0"
                                        Opacity="0"/>
                            </StackPanel>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Underline" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#8EBEFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabControl base style -->
        <Style TargetType="TabControl">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style TargetType="TabPanel">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <!-- Dark ContextMenu -->
        <Style TargetType="ContextMenu" x:Key="DarkContextMenu">
            <Setter Property="Background" Value="#111218"/>
            <Setter Property="BorderBrush" Value="#26262C"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Proper Dark MenuItem Template (with required layout!) -->
        <Style TargetType="MenuItem" x:Key="DarkMenuItem">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Background" Value="#111218"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">

                        <!-- REQUIRED for WPF to render correctly -->
                        <Grid>
                            <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#26262C"
                            BorderThickness="0"/>

                            <Grid Margin="6,2">
                                <!-- Left icon area -->
                                <ContentPresenter x:Name="Icon"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          ContentSource="Icon"/>

                                <!-- Menu text -->
                                <ContentPresenter x:Name="Text"
                                          Grid.Column="1"
                                          Margin="22,0,0,0"
                                          VerticalAlignment="Center"
                                          ContentSource="Header"/>
                            </Grid>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1F2A3F"/>
                                <Setter Property="Foreground" Value="#8EBEFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkMenuItemParent" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Background" Value="#111218"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">

                        <Grid>
                            <!-- Button Area -->
                            <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#26262C"
                            BorderThickness="0"/>

                            <Grid Margin="6,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                </Grid.ColumnDefinitions>

                                <!-- ICON -->
                                <ContentPresenter Grid.Column="0"
                                          ContentSource="Icon"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0"/>

                                <!-- TEXT -->
                                <ContentPresenter Grid.Column="1"
                                          ContentSource="Header"
                                          VerticalAlignment="Center"/>

                                <!-- ▶ SUBMENU ARROW -->
                                <Path x:Name="Arrow"
                              Grid.Column="2"
                              Data="M0,0 L4,5 L0,10"
                              Stroke="#8EBEFF"
                              StrokeThickness="1.8"
                              Visibility="Collapsed"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"/>
                            </Grid>

                            <!-- POPUP (built-in WPF submenu host) -->
                            <Popup x:Name="Submenu"
                           Placement="Right"
                           AllowsTransparency="True"
                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                           PopupAnimation="Fade"
                           StaysOpen="False">
                                <Border Background="#111218"
                                BorderBrush="#26262C"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="2">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- TRIGGERS -->
                        <ControlTemplate.Triggers>

                            <!-- Highlight on hover -->
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1F2A3F"/>
                                <Setter Property="Foreground" Value="#8EBEFF"/>
                            </Trigger>

                            <!-- Show arrow if submenu exists -->
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            </Trigger>

                            <!-- Highlight when submenu is open -->
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1F2A3F"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ContextMenu" BasedOn="{StaticResource DarkContextMenu}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <!-- EXPANDER TOGGLE BUTTON (REQUIRED) -->
        <Style x:Key="TreeExpanderButtonStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">

                        <Grid Width="22" Height="22" Background="Transparent">

                            <!-- Centered arrow using a Viewbox -->
                            <Viewbox Width="10" Height="10"
                             Stretch="Uniform"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">

                                <Path x:Name="Arrow"
                              Data="M 0 0 L 4 5 L 0 10"
                              Stroke="#7F8B9F"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                            </Viewbox>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <!-- EXPANDED -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" CenterX="5" CenterY="5"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Arrow" Property="Stroke" Value="#A0C0FF"/>
                            </Trigger>

                            <!-- HOVER -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow" Property="Stroke" Value="#B5CFFF"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TreeItemGlowStyle" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="HeaderTemplate" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <!-- HEADER ROW -->
                            <Grid Margin="4,2,4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- HIGHLIGHT BACKGROUND -->
                                <Border x:Name="Highlight"
                                Grid.ColumnSpan="2"
                                Background="#0000"
                                CornerRadius="4"
                                Opacity="0"/>

                                <!-- EXPANDER -->
                                <ToggleButton x:Name="ExpanderToggle"
                                      Grid.Column="0"
                                      Style="{StaticResource TreeExpanderButtonStyle}"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                      Visibility="Collapsed"/>

                                <!-- HEADER CONTENT (whatever you set as Header) -->
                                <ContentPresenter Grid.Column="1"
                                          Margin="4,0,0,0"
                                          VerticalAlignment="Center"
                                          ContentSource="Header"/>
                            </Grid>

                            <!-- CHILDREN -->
                            <ItemsPresenter x:Name="ChildrenHost"
                                    Margin="20,2,4,2"/>
                        </StackPanel>

                        <ControlTemplate.Triggers>
                            <!-- Show expander if there are children -->
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="ExpanderToggle"
                                Property="Visibility"
                                Value="Visible"/>
                            </Trigger>

                            <!-- Collapse children when not expanded -->
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ChildrenHost"
                                Property="Visibility"
                                Value="Collapsed"/>
                            </Trigger>

                            <!-- Hover highlight -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Highlight"
                                Property="Opacity"
                                Value="0.22"/>
                                <Setter TargetName="Highlight"
                                Property="Background"
                                Value="#263049"/>
                            </Trigger>

                            <!-- Selected highlight -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Highlight"
                                Property="Opacity"
                                Value="1"/>
                                <Setter TargetName="Highlight"
                                Property="Background"
                                Value="#263049"/>
                                <Setter TargetName="Highlight" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#5AA6FF"
                                                  BlurRadius="22"
                                                  ShadowDepth="0"
                                                  Opacity="0.55"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Easing -->
        <SineEase x:Key="SineEaseOut" EasingMode="EaseOut"/>
        <SineEase x:Key="SineEaseIn" EasingMode="EaseIn"/>

        <!-- Fade animations for preview -->
        <Storyboard x:Key="PreviewFadeOut">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             To="0"
                             Duration="0:0:0.12"
                             FillBehavior="Stop"/>
        </Storyboard>

        <Storyboard x:Key="PreviewFadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="1"
                             Duration="0:0:0.15"/>
        </Storyboard>

        <!-- Spinner animation -->
        <Storyboard x:Key="SpinnerPremium" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360"
                             Duration="0:0:1.4"
                             RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="SweepRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360"
                             Duration="0:0:0.9"
                             RepeatBehavior="Forever"/>
        </Storyboard>

        <Storyboard x:Key="SlideLeftIn">
            <DoubleAnimation Storyboard.TargetName="SlideTransform"
                     Storyboard.TargetProperty="X"
                     From="200" To="0"
                     Duration="0:0:0.25"
                     EasingFunction="{StaticResource SineEaseOut}"/>
        </Storyboard>

        <Storyboard x:Key="SlideLeftOut">
            <DoubleAnimation Storyboard.TargetName="SlideTransform"
                     Storyboard.TargetProperty="X"
                     From="0" To="-200"
                     Duration="0:0:0.25"
                     EasingFunction="{StaticResource SineEaseIn}"/>
        </Storyboard>

        <Storyboard x:Key="SlideRightIn">
            <DoubleAnimation Storyboard.TargetName="SlideTransform"
                     Storyboard.TargetProperty="X"
                     From="-200" To="0"
                     Duration="0:0:0.25"
                     EasingFunction="{StaticResource SineEaseOut}"/>
        </Storyboard>

        <Storyboard x:Key="SlideRightOut">
            <DoubleAnimation Storyboard.TargetName="SlideTransform"
                     Storyboard.TargetProperty="X"
                     From="0" To="200"
                     Duration="0:0:0.25"
                     EasingFunction="{StaticResource SineEaseIn}"/>
        </Storyboard>


    </Window.Resources>
    
    <DockPanel>

            <!-- HEADER BAR -->
            <Border DockPanel.Dock="Top"
                Background="{StaticResource HeaderBgBrush}"
                Height="40">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                        <TextBlock Text="UnrealPorting"
                               Foreground="#E5E7EB"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,18,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN AREA -->
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0" Margin="0,0,14,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#5AA6FF"
                                      BlurRadius="25"
                                      ShadowDepth="0"
                                      Opacity="0.35"/>
                    </Border.Effect>
                    <Border Background="#14141A"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="#26262C"
                        Opacity="0.92">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- glow strip -->
                            <Border Grid.Column="0"
                                Background="{StaticResource SidebarGlowBrush}"
                                CornerRadius="6,0,0,6" />

                            <!-- nav content -->
                            <StackPanel Grid.Column="1"
                                    Margin="12,10,12,10">
                                <TextBlock Text="Navigation"
                                       Foreground="#9CA3AF"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="2,0,0,4"/>

                                <Button Style="{StaticResource SidebarNavButton}"
                                    Content="Game Profiles"
                                    Click="OpenDirectoryWindow_Click"/>

                                <Button Style="{StaticResource SidebarNavButton}"
                                    Content="AES Keys"
                                    Click="OpenAESWindow_Click"/>

                                <Button Style="{StaticResource SidebarNavButton}"
                                    Content="Asset Search"
                                    Click="OpenSearchWindow_Click"/>

                                <Button Style="{StaticResource SidebarNavButton}"
                                    Content="Settings"
                                    Click="OpenSettingsWindow_Click"/>
                                <Button Style="{StaticResource SidebarNavButton}"
                                    Content="Logs"
                                    Click="OpenLogsWindow_Click"/>

                                <Separator Margin="0,16,0,8"/>

                                <TextBlock Text="Tips"
                                       Foreground="#6B7280"
                                       FontSize="11"
                                       Margin="2,0,0,4"/>

                                <TextBlock Text="• Load AES + Archives first."
                                       Foreground="#6B7280"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                                <TextBlock Text="• Browse Game Folders, then Packages."
                                       Foreground="#6B7280"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                            <TextBlock x:Name="AppVersionLabel"
                                       Text="Version"
                                       FontSize="11"
                                       Foreground="#5AA6FF"
                                       Opacity="0.75"
                                       HorizontalAlignment="Left"
                                       Margin="2,40,0,0"/>

                        </StackPanel>
                        </Grid>
                    </Border>
                </Border>

                <!-- MAIN CONTENT -->
                <Grid Grid.Column="1" Margin="10,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: TABS + PILL HEADER -->
                    <Border Grid.Column="0"
                        CornerRadius="12"
                        Opacity="0.92"
                        BorderThickness="1"
                        BorderBrush="#26262C">
                        <Border.Effect>
                            <DropShadowEffect Color="#5AA6FF"
                                          BlurRadius="25"
                                          ShadowDepth="0"
                                          Opacity="0.35"/>
                        </Border.Effect>
                        <Border Background="#14141A"
                            CornerRadius="12"
                            BorderThickness="0"
                            Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- PILL HEADER -->
                                <Grid Grid.Row="0"
                                  Margin="3,5,3,0"
                                  HorizontalAlignment="Stretch">
                                    <Border Background="#111218"
                                        CornerRadius="24"
                                        Padding="24,10"
                                        BorderThickness="1"
                                        BorderBrush="#26262C"
                                        HorizontalAlignment="Center">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#5AA6FF"
                                                          BlurRadius="25"
                                                          ShadowDepth="0"
                                                          Opacity="0.40"/>
                                        </Border.Effect>

                                        <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                            <!-- ARCHIVES -->
                                            <StackPanel HorizontalAlignment="Center"
                                                    Margin="5,5,5,0">
                                                <TextBlock Text="Archives"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#E5E7EB"
                                                       Cursor="Hand"
                                                       Padding="5,0"
                                                       MouseLeftButtonDown="PillHeader_Archives_Click">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Opacity" Value="0.7"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainTabControl}"
                                                                         Value="0">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                    <Setter Property="Foreground" Value="#8EBEFF"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <Border Height="3"
                                                    Width="30"
                                                    CornerRadius="2"
                                                    Margin="0,4,0,0"
                                                    Background="#5AA6FF">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Opacity" Value="0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainTabControl}"
                                                                         Value="0">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </StackPanel>

                                            <!-- GAME FOLDERS -->
                                            <StackPanel HorizontalAlignment="Center"
                                                    Margin="5,5,5,0">
                                                <TextBlock Text="Game Folders"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#E5E7EB"
                                                       Cursor="Hand"
                                                       Padding="5,0"
                                                       MouseLeftButtonDown="PillHeader_GameFolders_Click">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Opacity" Value="0.7"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainTabControl}"
                                                                         Value="1">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                    <Setter Property="Foreground" Value="#8EBEFF"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <Border Height="3"
                                                    Width="30"
                                                    CornerRadius="2"
                                                    Margin="0,4,0,0"
                                                    Background="#5AA6FF">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Opacity" Value="0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainTabControl}"
                                                                         Value="1">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </StackPanel>

                                            <!-- GAME PACKAGES -->
                                            <StackPanel HorizontalAlignment="Center" Margin="5,5,5,0">
                                                <TextBlock Text="Game Packages"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#E5E7EB"
                                                       Cursor="Hand"
                                                       Padding="5,0"
                                                       MouseLeftButtonDown="PillHeader_GamePackages_Click">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Opacity" Value="0.7"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainTabControl}"
                                                                         Value="2">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                    <Setter Property="Foreground" Value="#8EBEFF"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <Border Height="3"
                                                    Width="30"
                                                    CornerRadius="2"
                                                    Margin="0,4,0,0"
                                                    Background="#5AA6FF">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Opacity" Value="0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainTabControl}"
                                                                         Value="2">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </StackPanel>

                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- TAB CONTENT (headers hidden) -->
                                <TabControl x:Name="MainTabControl"
                                Grid.Row="1"
                                SelectedIndex="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="10,6,10,0">

                                    <!-- Hide default headers -->
                                    <TabControl.Template>
                                        <ControlTemplate TargetType="TabControl">
                                            <Grid>
                                                <!-- Hidden default tab headers -->
                                                <Grid x:Name="HeaderPanel" Visibility="Collapsed">
                                                    <ItemsPresenter />
                                                </Grid>

                                                <!-- Shows the selected tab's content -->
                                                <ContentPresenter ContentSource="SelectedContent" />
                                            </Grid>
                                        </ControlTemplate>
                                    </TabControl.Template>


                                    <!-- ARCHIVES TAB -->
                                    <TabItem Header="Archives">
                                        <Grid Margin="0,10,0,0">
                                            <StackPanel>
                                                <Button x:Name="BtnLoadArchives"
                                                        Content="Load AES and Mount Archives"
                                                        FontWeight="SemiBold"
                                                        Width="220" Height="30"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,0,0,10"
                                                        Click="BtnLoadArchives_Click"
                                                        Foreground="White"
                                                        BorderBrush="#5AA6FF"
                                                        Background="#5AA6FF"
                                                        BorderThickness="1">
                                                    <Button.Effect>
                                                    <DropShadowEffect Color="#5AA6FF"
                                                                      BlurRadius="20"
                                                                      ShadowDepth="0"
                                                                      Opacity="0.6"/>
                                                    </Button.Effect>
                                                </Button>

                                                <TreeView x:Name="ArchivesTreeView"
                                                      Style="{StaticResource DarkTreeView}"
                                                      ItemContainerStyle="{StaticResource TreeItemGlowStyle}"
                                                      SelectedItemChanged="ArchivesTreeView_SelectedItemChanged"
                                                      Foreground="White"
                                                      Background="#14141A"/>
                                            </StackPanel>
                                        </Grid>
                                    </TabItem>

                                <!-- GAME FOLDERS TAB -->
                                <TabItem Header="Game Folders">
                                    <Grid Margin="0,10,0,0">
                                        <TreeView x:Name="GameFoldersTreeView"
                                                  Style="{StaticResource DarkTreeView}"
                                                  SelectedItemChanged="GameFoldersTreeView_SelectedItemChanged"
                                                  MouseDoubleClick="GameFoldersTreeView_MouseDoubleClick">

                                            <!-- Only this TreeView gets its own item style -->
                                            <TreeView.Resources>

                                                <!-- CLOSED FOLDER TEMPLATE -->
                                                <DataTemplate x:Key="FolderClosedTemplate">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{StaticResource FolderClosedIcon}"
                                                               Width="16" Height="16"
                                                               Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding}" Foreground="White"/>
                                                    </StackPanel>
                                                </DataTemplate>

                                                <!-- OPEN FOLDER TEMPLATE -->
                                                <DataTemplate x:Key="FolderOpenTemplate">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{StaticResource FolderOpenIcon}"
                                                               Width="16" Height="16"
                                                               Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding}" Foreground="White"/>
                                                    </StackPanel>
                                                </DataTemplate>

                                                <!-- MAIN GAME FOLDER ITEM STYLE -->
                                                <Style TargetType="TreeViewItem">
                                                    <Setter Property="Padding" Value="2"/>

                                                    <!-- Default header uses CLOSED template -->
                                                    <Setter Property="HeaderTemplate"
                                                            Value="{StaticResource FolderClosedTemplate}"/>

                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="TreeViewItem">

                                                                <StackPanel>

                                                                    <!-- HEADER AREA -->
                                                                    <Border x:Name="HeaderHighlight"
                                                                            Background="#0000"
                                                                            CornerRadius="4"
                                                                            Margin="2,1"
                                                                            Padding="2">

                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="24"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <!-- Expand arrow -->
                                                                            <ToggleButton x:Name="ExpanderToggle"
                                                                                          Grid.Column="0"
                                                                                          HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"
                                                                                          Style="{StaticResource TreeExpanderButtonStyle}"
                                                                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                                                          Visibility="Collapsed"/>

                                                                            <!-- ICON + TEXT from HeaderTemplate -->
                                                                            <ContentPresenter Grid.Column="1"
                                                                                              Margin="4,0,0,0"
                                                                                              VerticalAlignment="Center"
                                                                                              Content="{TemplateBinding Header}"
                                                                                              ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                                                                        </Grid>
                                                                    </Border>

                                                                    <!-- CHILDREN -->
                                                                    <ItemsPresenter x:Name="ItemsHost"
                                                                                    Margin="20,2,4,2"/>

                                                                </StackPanel>

                                                                <ControlTemplate.Triggers>

                                                                    <!-- If node has children → show expander -->
                                                                    <Trigger Property="HasItems" Value="True">
                                                                        <Setter TargetName="ExpanderToggle"
                                                                                Property="Visibility" Value="Visible"/>
                                                                    </Trigger>

                                                                    <!-- Collapse children -->
                                                                    <Trigger Property="IsExpanded" Value="False">
                                                                        <Setter TargetName="ItemsHost"
                                                                                Property="Visibility" Value="Collapsed"/>
                                                                    </Trigger>

                                                                    <!-- Expanded → swap to OPEN folder icon -->
                                                                    <Trigger Property="IsExpanded" Value="True">
                                                                        <Setter Property="HeaderTemplate"
                                                                                Value="{StaticResource FolderOpenTemplate}"/>
                                                                    </Trigger>

                                                                    <!-- Hover highlight -->
                                                                    <Trigger SourceName="HeaderHighlight"
                                                                             Property="IsMouseDirectlyOver"
                                                                             Value="True">
                                                                        <Setter TargetName="HeaderHighlight"
                                                                                Property="Background"
                                                                                Value="#263049"/>
                                                                        <Setter TargetName="HeaderHighlight"
                                                                                Property="Opacity" Value="0.6"/>
                                                                    </Trigger>

                                                                    <!-- Selected highlight -->
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="HeaderHighlight"
                                                                                Property="Background"
                                                                                Value="#263049"/>
                                                                        <Setter TargetName="HeaderHighlight"
                                                                                Property="Opacity" Value="1"/>
                                                                        <Setter TargetName="HeaderHighlight"
                                                                                Property="Effect">
                                                                            <Setter.Value>
                                                                                <DropShadowEffect Color="#5AA6FF"
                                                                                                  BlurRadius="18"
                                                                                                  ShadowDepth="0"
                                                                                                  Opacity="0.55"/>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Trigger>

                                                                </ControlTemplate.Triggers>

                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>

                                            </TreeView.Resources>
                                        </TreeView>
                                    </Grid>
                                </TabItem>


                                <!-- GAME PACKAGES TAB -->
                                    <TabItem Header="Game Packages">
                                        <Grid Margin="0,10,0,0">
                                            <TreeView x:Name="GamePackagesTreeView"
                                                  Style="{StaticResource DarkTreeView}"
                                                  ItemContainerStyle="{StaticResource TreeItemGlowStyle}"
                                                  SelectedItemChanged="GamePackagesTreeView_SelectedItemChanged">

                                                <TreeView.Resources>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                                    </Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                                    </Style>
                                                </TreeView.Resources>

                                            <TreeView.ContextMenu>
                                                <ContextMenu Style="{StaticResource DarkContextMenu}">
                                                    <MenuItem Header="Export Texture"
                                                              Click="ExportTextures_Click"
                                                              Style="{StaticResource DarkMenuItem}"/>
                                                    <MenuItem Header="Export Raw JSON"
                                                              Click="ExportJson_Click"
                                                              Style="{StaticResource DarkMenuItem}"/>
                                                    <MenuItem Header="Export Referenced Textures"
                                                              Click="ExportReferencedTextures_Click"
                                                              Style="{StaticResource DarkMenuItem}"/>
                                                    <MenuItem Header="Export Selected Mip..."
                                                              Click="ExportMip_Click"
                                                              Style="{StaticResource DarkMenuItem}"/>
                                                    <MenuItem Header="Copy" Style="{StaticResource DarkMenuItemParent}">
                                                        <MenuItem Header="Full Path" Click="CopyFullPath_Click" Style="{StaticResource DarkMenuItem}"/>
                                                        <MenuItem Header="Full Path W/o Extentinsion" Click="CopyNoExt_Click" Style="{StaticResource DarkMenuItem}"/>
                                                        <MenuItem Header="Unreal Object Path" Click="CopyObjectPath_Click" Style="{StaticResource DarkMenuItem}"/>
                                                        <MenuItem Header="Blueprint Reference Path (For Experienced Users)" Click="CopyBlueprintRef_Click" Style="{StaticResource DarkMenuItem}"/>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </TreeView.ContextMenu>
                                        </TreeView>
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Border>
                    </Border>

                    <!-- RIGHT: PREVIEW PANEL -->
                    <Border Grid.Column="1"
                        BorderThickness="1"
                        CornerRadius="12"
                        Margin="10,0,0,0"
                        Background="#14141A"
                        BorderBrush="#26262C"
                        Opacity="0.92">
                        <Border.Effect>
                            <DropShadowEffect Color="#5AA6FF"
                                          BlurRadius="25"
                                          ShadowDepth="0"
                                          Opacity="0.35"/>
                        </Border.Effect>
                        <Border Background="#14141A"
                            CornerRadius="12"
                            BorderThickness="0"
                            Padding="0">
                            <Grid>

                                <!-- Single pane -->
                                <Grid x:Name="SinglePaneGrid">
                                    <ListBox x:Name="JsonList"
                                         Background="#111"
                                         Foreground="White"
                                         BorderThickness="0"
                                         FontFamily="Consolas"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                         MouseDoubleClick="JsonList_MouseDoubleClick">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <local:JsonLineControl Text="{Binding}"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>

                                <!-- Dual pane (text + image) -->
                            <Grid x:Name="DualPaneGrid" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="350" />
                                </Grid.ColumnDefinitions>

                                <ScrollViewer Grid.Column="0"
                                              Background="#111"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto">
                                    <TextBox x:Name="PreviewText_Dual"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             FontFamily="Consolas"
                                             Background="#111"
                                             Foreground="White"
                                             BorderThickness="0"
                                             Padding="6"/>
                                </ScrollViewer>

                                <Border Grid.Column="1"
                                        Background="#111"
                                        BorderBrush="#222"
                                        BorderThickness="1"
                                        Padding="6">
                                    <Viewbox Stretch="Uniform">
                                        <Grid Width="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}">
                                            <Image x:Name="PreviewImage"
                                                   Stretch="Uniform"
                                                   SnapsToDevicePixels="True"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </Grid>
                                    </Viewbox>
                                </Border>
                            </Grid>

                            <!-- LOADING OVERLAY -->
                            <Grid x:Name="LoadingOverlay"
                                  Visibility="Collapsed"
                                  Background="#00000055"
                                  Panel.ZIndex="9999">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">

                                    <!-- background ring -->
                                    <Ellipse Width="40" Height="40"
                                             Stroke="#1AFFFFFF"
                                             StrokeThickness="4"/>

                                    <!-- main spinning arc -->
                                    <Grid RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                                        </Grid.RenderTransform>

                                        <Path StrokeThickness="4"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round">
                                            <Path.Stroke>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#5AA6FF" Offset="0"/>
                                                    <GradientStop Color="#A47CFF" Offset="0.5"/>
                                                    <GradientStop Color="#5AA6FF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Path.Stroke>
                                            <Path.Data>
                                                <PathGeometry>
                                                    <PathFigure StartPoint="20,4">
                                                        <ArcSegment Point="36,20"
                                                                    Size="16,16"
                                                                    SweepDirection="Clockwise"
                                                                    IsLargeArc="False"/>
                                                    </PathFigure>
                                                </PathGeometry>
                                            </Path.Data>
                                            <Path.Effect>
                                                <DropShadowEffect Color="#6EA8FF"
                                                                  BlurRadius="45"
                                                                  Opacity="0.9"
                                                                  ShadowDepth="0"/>
                                            </Path.Effect>
                                        </Path>
                                    </Grid>

                                    <!-- energy sweep -->
                                    <Grid RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <RotateTransform x:Name="SweepRotate" Angle="0"/>
                                        </Grid.RenderTransform>

                                        <Path StrokeThickness="4"
                                              Opacity="0.35"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round">
                                            <Path.Stroke>
                                                <RadialGradientBrush RadiusX="1" RadiusY="1"
                                                                     Center="0.5,0.5"
                                                                     GradientOrigin="0.5,0.5">
                                                    <GradientStop Color="#FF00CAFF" Offset="0"/>
                                                    <GradientStop Color="#A08230FF" Offset="0.4"/>
                                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                </RadialGradientBrush>
                                            </Path.Stroke>
                                            <Path.Effect>
                                                <DropShadowEffect Color="#A47CFF"
                                                                  BlurRadius="45"
                                                                  ShadowDepth="0"
                                                                  Opacity="0.75"/>
                                            </Path.Effect>
                                            <Path.Data>
                                                <PathGeometry>
                                                    <PathFigure StartPoint="20,4">
                                                        <ArcSegment Point="36,20"
                                                                    Size="16,16"
                                                                    SweepDirection="Clockwise"
                                                                    IsLargeArc="False"/>
                                                    </PathFigure>
                                                </PathGeometry>
                                            </Path.Data>
                                        </Path>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                        </Border>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>
</Window>