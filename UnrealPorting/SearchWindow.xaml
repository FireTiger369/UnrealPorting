<Window x:Class="UnrealPorting.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search Assets"
        Width="900"
        Height="500"
        Background="#111218"
        Foreground="White"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>

        <Style x:Key="RoundedListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0 4"/>
            <Setter Property="Background" Value="#1F1F23"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#26262C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                        CornerRadius="8"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="6" />
                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- BRIGHTER HOVER -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2C3A56"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#5AA6FF"/>

                                <!-- Optional light glow for theme -->
                                <Setter TargetName="ItemBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#5AA6FF"
                                                  BlurRadius="18"
                                                  ShadowDepth="0"
                                                  Opacity="0.55"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <!-- SELECTED -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#14254E"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#5AA6FF"/>
                                <Setter TargetName="ItemBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#5AA6FF"
                                                  BlurRadius="22"
                                                  ShadowDepth="0"
                                                  Opacity="0.65"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- SEARCH BOX CONTAINER -->
        <Border Background="#14141A"
        CornerRadius="8"
        BorderBrush="#26262C"
        BorderThickness="1"
        Padding="10"
        Margin="0,0,0,12">

            <Grid>

                <!-- Placeholder text (improved look) -->
                <TextBlock x:Name="PlaceholderText"
                   Text="Search assets..."
                   Foreground="#5F6570"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Margin="2,1,0,0"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Opacity="0.85"/>

                <!-- Actual search box -->
                <TextBox x:Name="SearchBox"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="White"
                 FontSize="14"
                 FontWeight="SemiBold"
                 Padding="0"
                 TextChanged="SearchBox_TextChanged"
                 KeyUp="SearchBox_KeyUp"/>
            </Grid>
        </Border>

        <!-- RESULTS LIST -->
        <Border Grid.Row="1"
                Background="#14141A"
                CornerRadius="10"
                BorderBrush="#26262C"
                BorderThickness="1"
                Padding="6">
            <Border.Effect>
                <DropShadowEffect Color="#5AA6FF"
                                  BlurRadius="25"
                                  ShadowDepth="0"
                                  Opacity="0.35"/>
            </Border.Effect>

            <ListBox x:Name="ResultsList"
                     Background="Transparent"
                     Foreground="White"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MouseDoubleClick="ResultsList_MouseDoubleClick"
                     ItemContainerStyle="{StaticResource RoundedListItemStyle}"/>
        </Border>
    </Grid>
</Window>
