<Window x:Class="UnrealPorting.AESWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AES Key Manager"
        Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e1e"
        Foreground="White">

    <Grid Margin="10">
        <!-- Layout rows -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Scroll content -->
            <RowDefinition Height="Auto"/>
            <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="AES Key Manager"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"
                   Grid.Row="0"/>

        <!-- Scrollable dynamic AES list -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Background="#252525"
                      Padding="5"
                      BorderBrush="#333"
                      BorderThickness="1">
            <StackPanel x:Name="AESListPanel"
                        Orientation="Vertical"
                        Margin="0,5,0,0"/>
        </ScrollViewer>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Confirm"
                    Width="120"
                    Margin="5"
                    Padding="5"
                    Background="#007ACC"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="Confirm_Click"/>
            <Button Content="Cancel"
                    Width="120"
                    Margin="5"
                    Padding="5"
                    Background="#333"
                    Foreground="White"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
