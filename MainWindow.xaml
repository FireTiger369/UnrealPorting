<Window x:Class="UnrealPorting.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:UnrealPorting"
        Title="Unreal Porting Tool"
        Height="900" Width="1600"
        Background="#2E2E2E"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DropShadowEffect x:Key="PanelGlow"
                  Color="#5AA6FF"
                  BlurRadius="30"
                  ShadowDepth="0"
                  Opacity="0.35"/>

        <!-- Icons (unchanged) -->
        <BitmapImage x:Key="FolderClosedIcon" UriSource="Icons/folder_closed.png"/>
        <BitmapImage x:Key="FolderOpenIcon"  UriSource="Icons/folder_open.png"/>
        <BitmapImage x:Key="AssetIcon" UriSource="Icons/asset_icon.png"/>

        <!-- Spinner color (unchanged) -->
        <SolidColorBrush x:Key="SpinnerBrush" Color="#5AA6FF"/>

        <!-- Spinner animation (unchanged) -->
        <Storyboard x:Key="SpinnerRotation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:1"/>
        </Storyboard>

        <!-- FortForge-like colors -->
        <SolidColorBrush x:Key="HeaderBgBrush" Color="#111218"/>
        <SolidColorBrush x:Key="SidebarBgBrush" Color="#0E0E10"/>
        <SolidColorBrush x:Key="SidebarButtonBg" Color="#15161C"/>
        <SolidColorBrush x:Key="SidebarButtonHoverBg" Color="#20212A"/>
        <SolidColorBrush x:Key="SidebarButtonText" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="PanelBgBrush" Color="#18181B"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#2A2A2D"/>

        <!-- Glowing gradient for the sidebar strip -->
        <LinearGradientBrush x:Key="SidebarGlowBrush"
                     StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#66A8FFFF" Offset="0.0"/>
            <GradientStop Color="#5AA6FF" Offset="0.25"/>
            <GradientStop Color="#A47CFF" Offset="0.55"/>
            <GradientStop Color="#5AA6FF" Offset="0.85"/>
            <GradientStop Color="#66A8FFFF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Dark Tree background (retained but modernized) -->
        <Style TargetType="TreeView" x:Key="DarkTreeView">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style TargetType="TreeViewItem" x:Key="DarkTreeViewItem">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Sidebar text-only button style -->
        <Style x:Key="SidebarNavButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SidebarButtonBg}"/>
            <Setter Property="Foreground" Value="{StaticResource SidebarButtonText}"/>
            <Setter Property="BorderBrush" Value="#00000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="6,0,0,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SidebarButtonHoverBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Fade Out -->
        <Storyboard x:Key="PreviewFadeOut">
            <DoubleAnimation
                Storyboard.TargetProperty="Opacity"
                To="0"
                Duration="0:0:0.12"
                FillBehavior="Stop"/>
        </Storyboard>

        <Storyboard x:Key="PreviewFadeIn">
            <DoubleAnimation
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.15"/>
        </Storyboard>


    </Window.Resources>

    <DockPanel>

        <!-- TOP HEADER BAR (FortForge-ish, but using your existing Menu) -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource HeaderBgBrush}"
                Height="40">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: App title + Menu -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <TextBlock Text="UnrealPorting"
                               Foreground="#E5E7EB"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,18,0"/>
                </StackPanel>

                <!-- Right: you can add status text later if you want -->
            </Grid>
        </Border>


        <!-- MAIN AREA -->
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <!-- Sidebar -->
                <ColumnDefinition Width="200"/>
                <!-- Main content -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR WITH GLOW -->
            <Border Grid.Column="0" Margin="0,0,14,0">
                <Border.Effect>
                    <DropShadowEffect Color="#5AA6FF"
                                      BlurRadius="25"
                                      ShadowDepth="0"
                                      Opacity="0.35"/>
                </Border.Effect>
                <Border Grid.Column="0"
                    Background="#14141A"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="#26262C"
                    Opacity="0.92">
                    <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Glow strip -->
                        <ColumnDefinition Width="8"/>
                        <!-- Nav items -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Glowing vertical bar -->
                    <Border Grid.Column="0"
                            Background="{StaticResource SidebarGlowBrush}"
                            CornerRadius="6,0,0,6" />

                    <!-- Sidebar Content -->
                    <StackPanel Grid.Column="1"
                                Margin="12,10,12,10">
                        <TextBlock Text="Navigation"
                                   Foreground="#9CA3AF"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="2,0,0,4"/>

                        <!-- NOTE: these buttons only reuse existing handlers
                             so they DO NOT break your code-behind -->

                        <!-- Opens your directory/profile selector -->
                        <Button Style="{StaticResource SidebarNavButton}"
                                Content="Game Profiles"
                                Click="OpenDirectoryWindow_Click"/>

                        <!-- Opens AES window -->
                        <Button Style="{StaticResource SidebarNavButton}"
                                Content="AES Keys"
                                Click="OpenAESWindow_Click"/>

                        <!-- Opens global search window -->
                        <Button Style="{StaticResource SidebarNavButton}"
                                Content="Asset Search"
                                Click="OpenSearchWindow_Click"/>

                        <!-- Opens settings -->
                        <Button Style="{StaticResource SidebarNavButton}"
                                Content="Settings"
                                Click="OpenSettingsWindow_Click"/>

                        <Separator Margin="0,16,0,8"/>

                        <TextBlock Text="Tips"
                                   Foreground="#6B7280"
                                   FontSize="11"
                                   Margin="2,0,0,4"/>

                        <TextBlock Text="• Load AES + Archives first."
                                   Foreground="#6B7280"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="• Browse Game Folders, then Packages."
                                   Foreground="#6B7280"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
                </Border>
            </Border>


            <!-- MAIN CONTENT (LEFT = TABS, RIGHT = PREVIEW PANE) -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT PANEL: YOUR EXISTING TABCONTROL -->
                <Border Grid.Column="0"
                        Margin="0"
                        CornerRadius="12"
                        Opacity="0.92"
                        BorderThickness="1"
                        BorderBrush="#26262C">
                    <Border.Effect>
                        <DropShadowEffect Color="#5AA6FF" BlurRadius="25" ShadowDepth="0" Opacity="0.35"/> 
                    </Border.Effect>
                    <Border Padding="10"
                            CornerRadius="12"
                            Background="#14141A"
                            BorderThickness="0">
                        <TabControl x:Name="MainTabControl"
                                Background="#14141A"
                                Foreground="White">

                            <!-- Archives -->
                        <TabItem Background="White">
                            <TabItem.Header>
                                <TextBlock Text="Archives"
                                           Foreground="Black"/>
                            </TabItem.Header>
                            <DockPanel>

                                <!-- Top toolbar -->
                                <StackPanel DockPanel.Dock="Top"
                                            Orientation="Horizontal"
                                            Background="Transparent"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,4">
                                        <StackPanel.Effect>
                                            <DropShadowEffect Color="RoyalBlue"
                                                  BlurRadius="25"
                                                  ShadowDepth="0"
                                                  Opacity="0.6"/>
                                        </StackPanel.Effect>
                                        <Button x:Name="BtnLoadArchives"
                                            Content="Load AES and Mount Archives"
                                            FontWeight="Bold"
                                            Width="220" Height="30"
                                            Margin="0,4,0,4"
                                            Click="BtnLoadArchives_Click"
                                            Foreground="White"
                                            BorderBrush="RoyalBlue"
                                            Background="#FF14254E"/>
                                    </StackPanel>

                                <!-- Archives List -->
                                <TreeView x:Name="ArchivesTreeView"
                                          Style="{StaticResource DarkTreeView}"
                                          ItemContainerStyle="{StaticResource DarkTreeViewItem}"
                                          SelectedItemChanged="ArchivesTreeView_SelectedItemChanged"
                                          Foreground="White"
                                          Background="#14141A"/>
                            </DockPanel>
                        </TabItem>

                        <!-- GAME FOLDERS (WITH FOLDER ICONS) -->
                        <TabItem Background="White">
                            <TabItem.Header>
                                <TextBlock Text="Game Folders"
                                           Foreground="Black"/>
                            </TabItem.Header>
                            <TreeView x:Name="GameFoldersTreeView"
                                      Style="{StaticResource DarkTreeView}"
                                      SelectedItemChanged="GameFoldersTreeView_SelectedItemChanged"
                                      MouseDoubleClick="GameFoldersTreeView_MouseDoubleClick">

                                <TreeView.Resources>

                                    <!-- Folder closed -->
                                    <DataTemplate x:Key="FolderClosedTemplate">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{StaticResource FolderClosedIcon}"
                                                   Width="16" Height="16"
                                                   Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding}"
                                                       Foreground="White"/>
                                        </StackPanel>
                                    </DataTemplate>

                                    <!-- Folder open -->
                                    <DataTemplate x:Key="FolderOpenTemplate">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{StaticResource FolderOpenIcon}"
                                                   Width="16" Height="16"
                                                   Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding}"
                                                       Foreground="White"/>
                                        </StackPanel>
                                    </DataTemplate>

                                    <!-- Folder style (ONLY APPLIES HERE) -->
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="HeaderTemplate"
                                                Value="{StaticResource FolderClosedTemplate}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsExpanded" Value="True">
                                                <Setter Property="HeaderTemplate"
                                                        Value="{StaticResource FolderOpenTemplate}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>

                                </TreeView.Resources>

                            </TreeView>
                        </TabItem>

                        <!-- GAME PACKAGES (WITH ASSET ICONS) -->
                        <TabItem Background="White">
                            <TabItem.Header>
                                <TextBlock Text="Game Packages"
                                           Foreground="Black"/>
                            </TabItem.Header>
                            <TreeView Name="GamePackagesTreeView"
                                      SelectedItemChanged="GamePackagesTreeView_SelectedItemChanged"
                                      Style="{StaticResource DarkTreeView}">
                                <TreeView.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                    </Style>
                                    <Style TargetType="Image">
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                    </Style>
                                </TreeView.Resources>

                                <TreeView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Export Textures"
                                                  Click="ExportTextures_Click"/>
                                        <MenuItem Header="Export Raw JSON"
                                                  Click="ExportJson_Click"/>
                                        <MenuItem Header="Export Referenced Textures"
                                                  Click="ExportReferencedTextures_Click"/>
                                    </ContextMenu>
                                </TreeView.ContextMenu>

                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="HeaderTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <ContentPresenter Content="{Binding}" />
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                        </TabItem>

                    </TabControl>
                  </Border>
               </Border>

                <!-- RIGHT PANEL: PREVIEW (SINGLE / DUAL PANE) -->
                <Border Grid.Column="1"
                        BorderThickness="1"
                        CornerRadius="12"
                        Margin="10,0,0,0"
                        Background="#14141A"
                        BorderBrush="#26262C"
                        Opacity="0.92">
                    <Border.Effect>
                        <DropShadowEffect Color="#5AA6FF" BlurRadius="25" ShadowDepth="0" Opacity="0.35"/>
                    </Border.Effect>
                    <Border Padding="10"
                            CornerRadius="12"
                            Background="#14141A"
                            BorderThickness="0">
                    <Grid>
                        <!-- ONE-PANE MODE (DEFAULT) -->
                            <Grid x:Name="SinglePaneGrid">
                                <ListBox x:Name="JsonList"
                                     Background="#111"
                                     Foreground="White"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     MouseDoubleClick="JsonList_MouseDoubleClick">

                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <local:JsonLineControl Text="{Binding}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>


                            <!-- TWO-PANE MODE (FOR TEXTURES) -->
                        <Grid x:Name="DualPaneGrid" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="350" />
                            </Grid.ColumnDefinitions>

                            <!-- LEFT: TEXT -->
                            <ScrollViewer Grid.Column="0"
                                          Background="#111"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <TextBox x:Name="PreviewText_Dual"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         FontFamily="Consolas"
                                         Background="#111"
                                         Foreground="White"
                                         BorderThickness="0"
                                         Padding="6"/>
                            </ScrollViewer>

                            <!-- RIGHT: IMAGE -->
                            <Border Grid.Column="1"
                                    Background="#111"
                                    BorderBrush="#222"
                                    BorderThickness="1"
                                    Padding="6">
                                <!-- Square container -->
                                <Viewbox Stretch="Uniform">
                                    <Grid Width="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}">
                                        <Image x:Name="PreviewImage"
                                               Stretch="Uniform"
                                               SnapsToDevicePixels="True"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Grid>
                                </Viewbox>
                            </Border>
                        </Grid>

                        <!-- LOADING SPINNER: floats over preview -->
                            <Grid x:Name="LoadingSpinner"
                              Width="22" Height="22"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Margin="0,10,10,0"
                              Visibility="Hidden"
                              RenderTransformOrigin="0.5,0.5">

                                <Grid.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Grid.RenderTransform>

                                <Path Stroke="{StaticResource SpinnerBrush}"
                                  StrokeThickness="3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 11 2 A 9 9 0 0 1 20 11"/>
                            </Grid>
                        </Grid>
                </Border>
             </Border>

            </Grid>
        </Grid>

    </DockPanel>
</Window>