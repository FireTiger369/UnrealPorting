<Window x:Class="UnrealPorting.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unreal Porting Tool"
        Height="900" Width="1600"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Icons -->
        <BitmapImage x:Key="FolderClosedIcon" UriSource="Icons/folder_closed.png"/>
        <BitmapImage x:Key="FolderOpenIcon"  UriSource="Icons/folder_open.png"/>
        <BitmapImage x:Key="AssetIcon" UriSource="Icons/asset_icon.png"/>

        <!-- Spinner color -->
        <SolidColorBrush x:Key="SpinnerBrush" Color="#5AA6FF"/>

        <!-- Spinner animation -->
        <Storyboard x:Key="SpinnerRotation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:1"/>
        </Storyboard>

        <!-- Dark Tree background -->
        <Style TargetType="TreeView" x:Key="DarkTreeView">
            <Setter Property="Background" Value="#2E2E30"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style TargetType="TreeViewItem" x:Key="DarkTreeViewItem">
            <Setter Property="Foreground" Value="White"/>
        </Style>

    </Window.Resources>


    <DockPanel>

        <ToolBar DockPanel.Dock="Top" Background="#2D2D30">
            <DockPanel LastChildFill="True">

                <!-- LEFT SIDE: MENU -->
                <Menu Background="#FF2F2F2F" Foreground="White" DockPanel.Dock="Left">
                    <MenuItem Header="Directory">
                        <MenuItem Header="Path Select" Click="OpenDirectoryWindow_Click" Foreground="Black"/>
                        <MenuItem Header="AES Keys" Click="OpenAESWindow_Click" Foreground="Black"/>
                        <MenuItem Header="Search" Click="OpenSearchWindow_Click" Foreground="Black"/>
                    </MenuItem>

                    <MenuItem Header="Settings" Click="OpenSettingsWindow_Click"/>
                </Menu>
            </DockPanel>
        </ToolBar>



        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- LEFT PANEL -->
            <TabControl x:Name="MainTabControl"
                        Grid.Column="0"
                        Background="#252526"
                        Foreground="White">

                <!-- Archives -->
                <TabItem Header="Archives">
                    <TabItem.Background>
                        <LinearGradientBrush EndPoint="0,1">
                            <GradientStop Color="#FFF0F0F0"/>
                            <GradientStop Color="White" Offset="1"/>
                        </LinearGradientBrush>
                    </TabItem.Background>
                    <DockPanel>

                        <!-- Top toolbar -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#2D2D30" HorizontalAlignment="Center">
                            <Button x:Name="BtnLoadArchives"
                                Content="Load AES and Mount Archives" FontWeight="Bold"
                                Width="220" Height="30"
                                Margin="0,0,0,0"
                                Click="BtnLoadArchives_Click" Foreground="White"
                                BorderBrush="RoyalBlue" Background="#FF14254E"/>
                        </StackPanel>

                        <!-- Archives List -->
                        <TreeView x:Name="ArchivesTreeView"
                                Style="{StaticResource DarkTreeView}"
                                ItemContainerStyle="{StaticResource DarkTreeViewItem}"
                              SelectedItemChanged="ArchivesTreeView_SelectedItemChanged"
                              Foreground="White" Background="#FF2E2E2E"/>
                    </DockPanel>
                </TabItem>



                <!-- GAME FOLDERS (WITH FOLDER ICONS) -->
                <TabItem Header="Game Folders">
                    <TreeView x:Name="GameFoldersTreeView"
                              Style="{StaticResource DarkTreeView}"
                              SelectedItemChanged="GameFoldersTreeView_SelectedItemChanged"
                              MouseDoubleClick="GameFoldersTreeView_MouseDoubleClick">

                        <TreeView.Resources>

                            <!-- Folder closed -->
                            <DataTemplate x:Key="FolderClosedTemplate">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{StaticResource FolderClosedIcon}" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding}" Foreground="White"/>
                                </StackPanel>
                            </DataTemplate>

                            <!-- Folder open -->
                            <DataTemplate x:Key="FolderOpenTemplate">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{StaticResource FolderOpenIcon}" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding}" Foreground="White"/>
                                </StackPanel>
                            </DataTemplate>

                            <!-- Folder style (ONLY APPLIES HERE) -->
                            <Style TargetType="TreeViewItem">
                                <Setter Property="HeaderTemplate" Value="{StaticResource FolderClosedTemplate}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsExpanded" Value="True">
                                        <Setter Property="HeaderTemplate" Value="{StaticResource FolderOpenTemplate}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>

                        </TreeView.Resources>

                    </TreeView>
                </TabItem>

                <!-- GAME PACKAGES (WITH ASSET ICONS) -->
                <TabItem Header="Game Packages">
                    <TreeView Name="GamePackagesTreeView"
                              SelectedItemChanged="GamePackagesTreeView_SelectedItemChanged"
                              Style="{StaticResource DarkTreeView}">
                        <TreeView.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="IsHitTestVisible" Value="False"/>
                            </Style>
                            <Style TargetType="Image">
                                <Setter Property="IsHitTestVisible" Value="False"/>
                            </Style>
                        </TreeView.Resources>

                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Export Textures" Click="ExportTextures_Click"/>
                                <MenuItem Header="Export Raw JSON" Click="ExportJson_Click"/>
                                <MenuItem Header="Export Referenced Textures" Click="ExportReferencedTextures_Click"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>

                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="HeaderTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </TabItem>

            </TabControl>


            <Border Grid.Column="1" BorderBrush="#333" BorderThickness="1" Margin="2">
                <Grid>
                    <!-- ONE-PANE MODE (DEFAULT) -->
                    <Grid x:Name="SinglePaneGrid">
                        <ScrollViewer Background="#111"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
                            <TextBox x:Name="PreviewText_Single"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     FontFamily="Consolas"
                     Background="#111"
                     Foreground="White"
                     BorderThickness="0"
                     Padding="6"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- TWO-PANE MODE (FOR TEXTURES) -->
                    <Grid x:Name="DualPaneGrid" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="350" />
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: TEXT -->
                        <ScrollViewer Grid.Column="0"
                      Background="#111"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
                            <TextBox x:Name="PreviewText_Dual"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     FontFamily="Consolas"
                     Background="#111"
                     Foreground="White"
                     BorderThickness="0"
                     Padding="6"/>
                        </ScrollViewer>

                        <!-- RIGHT: IMAGE -->
                        <Border Grid.Column="1"
                            Background="#111"
                            BorderBrush="#222"
                            BorderThickness="1"
                            Padding="6">
                            <!-- Square container -->
                            <Viewbox Stretch="Uniform">
                                <Grid Width="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}">
                                    <Image x:Name="PreviewImage"
                                        Stretch="Uniform"
                                        SnapsToDevicePixels="True"
                                        RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Grid>
                            </Viewbox>
                        </Border>
                    </Grid>
                </Grid>
            </Border>


            <!-- LOADING SPINNER -->
            <Grid x:Name="LoadingSpinner"
                  Width="22" Height="22"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,10,10,0"
                  Visibility="Hidden"
                  RenderTransformOrigin="0.5,0.5">

                <Grid.RenderTransform>
                    <RotateTransform Angle="0"/>
                </Grid.RenderTransform>

                <Path Stroke="{StaticResource SpinnerBrush}"
                      StrokeThickness="3"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Data="M 11 2 A 9 9 0 0 1 20 11"/>
            </Grid>

        </Grid>

    </DockPanel>
</Window>