<Window x:Class="UnrealPorting.MappingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mappings Setup"
        Height="450" Width="650"
        Background="#222">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Folder Picker -->
        <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
            <TextBox x:Name="MappingsPathBox" Width="480" Margin="0 0 10 0"/>
            <Button x:Name="BrowseButton" Width="120" Content="Browse..." Click="Browse_Click"/>
        </StackPanel>

        <!-- List of found mappings -->
        <ListBox x:Name="MappingsList" Grid.Row="1" Background="#333" Foreground="White"/>

        <!-- Confirm / Cancel -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
            <Button Content="Cancel" Width="100" Margin="0 0 10 0" Click="Cancel_Click"/>
            <Button Content="Confirm" Width="100" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>

</Window>
