<Window x:Class="UnrealPorting.DirectorySelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Profiles"
        Width="600"
        Height="440"
        Background="#0E0E10"
        WindowStartupLocation="CenterScreen">

    <!-- ===========================
         GLOBAL STYLES
    ================================ -->
    <Window.Resources>

        <!-- Frosted glass card -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#2A2A2D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#5AA6FF"
                                      BlurRadius="18"
                                      ShadowDepth="0"
                                      Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header label -->
        <Style x:Key="CardHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0 0 0 8"/>
        </Style>

        <!-- Input labels -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Inputs -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1F1F23"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0 4"/>
        </Style>

        <!-- Buttons -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#5AA6FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6 4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#233043"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#182433"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>


    <!-- ===========================
         MAIN LAYOUT
    ================================ -->
    <Grid Margin="14">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- =======================
             EXISTING PROFILES
        ============================ -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardHeader}"
                           Text="Select Existing Profile"/>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Profile:" Width="100"/>
                    <ComboBox x:Name="ExistingProfilesCombo"
                              Width="250"
                              Margin="0 0 10 0">
                        <ComboBox.Resources>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="#2E2E2E"/>
                                <Setter Property="Padding" Value="4"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2D2D33"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#3A3A40"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Resources>
                    </ComboBox>

                </StackPanel>
            </StackPanel>
        </Border>


        <!-- =======================
             NEW PROFILE SECTION
        ============================ -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource CardHeader}"
                           Text="Add New Game Profile"
                           Grid.ColumnSpan="3"
                           Margin="0 0 0 16"/>

                <!-- Profile Name -->
                <TextBlock Text="Profile Name:"
                           Grid.Row="1"
                           Grid.Column="0"/>
                <StackPanel Margin="0,0,0,0" Background="Transparent" Grid.Row="1" Grid.Column="1">
                    <StackPanel.Effect>
                        <DropShadowEffect Color="RoyalBlue" BlurRadius="15" ShadowDepth="0" Opacity="0.6"/>
                    </StackPanel.Effect>
                    <TextBox x:Name="NewNameBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         Margin="6"/>
                </StackPanel>

                <!-- Directory -->
                <TextBlock Text="Game Directory:"
                           Grid.Row="2"
                           Grid.Column="0"/>
                <StackPanel Margin="0,0,0,0" Background="Transparent" Grid.Row="2" Grid.Column="1">
                    <TextBox x:Name="NewDirBox"
                         Grid.Row="2"
                         Grid.Column="1"
                         Margin="6"/>
                    <StackPanel.Effect>
                        <DropShadowEffect Color="RoyalBlue" BlurRadius="15" ShadowDepth="0" Opacity="0.6"/>
                    </StackPanel.Effect>
                </StackPanel>
                <Button Content="Browse..."
                        Grid.Row="2"
                        Grid.Column="2"
                        Margin="6"
                        Click="BrowseDirectory_Click"/>

                <!-- Engine Version -->
                <TextBlock Text="Engine Version:"
                           Grid.Row="3"
                           Grid.Column="0" Grid.ColumnSpan="2" Margin="6,12,340,0" VerticalAlignment="Top"/>
                <ComboBox x:Name="NewEngineCombo"
                          Grid.Row="3"
                          Grid.Column="1"
                          Margin="6,6,6,59">
                    <ComboBoxItem Content="UE4.16"/>
                    <ComboBoxItem Content="UE4.19"/>
                    <ComboBoxItem Content="UE4.20"/>
                    <ComboBoxItem Content="UE4.21"/>
                    <ComboBoxItem Content="UE4.22"/>
                    <ComboBoxItem Content="UE4.23"/>
                    <ComboBoxItem Content="UE4.24"/>
                    <ComboBoxItem Content="UE4.25"/>
                    <ComboBoxItem Content="UE4.26"/>
                    <ComboBoxItem Content="UE4.27"/>
                    <ComboBoxItem Content="UE5.0"/>
                    <ComboBoxItem Content="UE5.1"/>
                    <ComboBoxItem Content="UE5.2"/>
                    <ComboBoxItem Content="UE5.3"/>
                    <ComboBoxItem Content="UE5.4"/>
                    <ComboBoxItem Content="UE5.5"/>
                    <ComboBoxItem Content="UE5.6"/>
                </ComboBox>
                <StackPanel Background="Transparent" Orientation="Vertical" Grid.Column="1" Grid.Row="3" VerticalAlignment="Top" HorizontalAlignment="Center" Height="41" Margin="0,45,0,0" Width="261">
                    <Button Content="Add Game Profile"
                        FontWeight="Bold"
                        FontSize="12"
                        Height="35"
                        Width="214"
                        HorizontalAlignment="Center"
                        Click="AddGame_Click" RenderTransformOrigin="0.544,2.453"
                        Foreground="White"
                        Background="#FF14254E"
                        BorderBrush="RoyalBlue"/>
                    <StackPanel.Effect>
                        <DropShadowEffect Color="RoyalBlue" BlurRadius="25" ShadowDepth="0" Opacity="0.7"/>
                    </StackPanel.Effect>
                </StackPanel>
            </Grid>
        </Border>


        <!-- =======================
             OK / CANCEL
        ============================ -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 12 0 0">
            <Button Content="OK"
                    Width="100"
                    Margin="5"
                    Click="OK_Click"/>

            <Button Content="Cancel"
                    Width="100"
                    Margin="5"
                    Click="Cancel_Click"/>
        </StackPanel>

    </Grid>
</Window>